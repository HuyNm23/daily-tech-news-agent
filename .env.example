# ==============================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO DAILY NEWS AGENT
# Đổi tên file này thành .env để áp dụng cấu hình
# ==============================================================================

# 1. Chọn chế độ hoạt động: 'gemini', 'openai', hoặc 'offline'
# Mặc định là 'offline' (không tốn phí, không cần API key)
AI_PROVIDER=offline

# 2. Khóa API (Nếu bạn muốn dùng AI xịn hơn):
# Lấy miễn phí tại: https://aistudio.google.com/
GEMINI_API_KEY=

# Hoặc lấy tại: https://platform.openai.com/
OPENAI_API_KEY=

# 3. Cấu hình Telegram (Tùy chọn - nếu muốn Agent tự bắn tin về điện thoại):
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
